# OpenAI
OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-5

# Vercel Marketplace Redis / Upstash Redis REST credentials.
# Vercel may expose KV_REST_API_*; Upstash may expose UPSTASH_REDIS_REST_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron endpoint security. Set the same value in Vercel project env vars.
CRON_SECRET=

# Notifications
NOTIFICATION_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# SMTP, used only when NOTIFICATION_CHANNEL=email
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_AUTH_METHOD=basic
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_OAUTH2_USER=
SMTP_OAUTH2_ACCESS_TOKEN=
SMTP_FROM_EMAIL=
SMTP_RESULT_RECIPIENT=
