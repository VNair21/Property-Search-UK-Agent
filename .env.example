# OpenAI default model. Users enter their own secret key in the dashboard.
DEFAULT_OPENAI_MODEL=gpt-5

# Redis Cloud. Use the Node.js / Redis SDK connection string from Redis Cloud.
# Format: redis[s]://[[username][:password]@][host][:port][/db-number]
REDIS_URL=

# Alternative: Vercel Marketplace Redis / Upstash Redis REST credentials.
# Vercel may expose KV_REST_API_*; Upstash may expose UPSTASH_REDIS_REST_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron endpoint security. Set the same value in Vercel project env vars.
CRON_SECRET=

# Optional fallback Telegram notifications. Users can enter these in the dashboard instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
